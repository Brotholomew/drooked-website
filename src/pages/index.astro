---
import HomeLayout from '../layouts/HomeLayout.astro';
import HeaderComposition from '../components/HeaderComposition.astro';
import CmykIconLink from '../components/CmykIconLink.astro';
import CmykLink from '../components/CmykLink.astro';

const socialLinks = [
  {
    network: 'instagram' as const,
    href: 'https://www.instagram.com/droocked.origins',
    label: 'Instagram',
  },
  {
    network: 'tiktok' as const,
    href: 'https://www.tiktok.com/@droocked.origins',
    label: 'TikTok',
  },
  {
    network: 'youtube' as const,
    href: 'https://www.youtube.com/@droocked.origins',
    label: 'YouTube',
  },
  {
    network: 'mail' as const,
    href: 'mailto:contact@droocked.com',
    label: 'Mail',
  },
];

const navLinks = [
  { href: '/knowledgebase/', text: 'knowledgebase' },
  { href: '/projects/', text: 'projects' },
  { href: '/products/', text: 'products' },
  { href: '/contact/', text: 'contact me' },
];
---

<HomeLayout
  title="droocked.origins"
  description="droocked.origins — 3D printing products, projects, and knowledge."
>
  <h1 class="visually-hidden">droocked.origins</h1>

  <div class="home">
    <div class="home__header">
      <HeaderComposition />
    </div>

    <ul class="home__social" role="list">
      {
        socialLinks.map((link) => (
          <li>
            <CmykIconLink
              network={link.network}
              href={link.href}
              label={link.label}
              target={link.network === 'mail' ? undefined : '_blank'}
              rel={link.network === 'mail' ? undefined : 'noopener noreferrer'}
            />
          </li>
        ))
      }
    </ul>

    <nav class="home__nav" aria-label="Sections">
      {
        navLinks.map((link, index) => (
          <>
            {index > 0 && (
              <span class="home__nav-sep" aria-hidden="true">
                ·
              </span>
            )}
            <CmykLink href={link.href} text={link.text} />
          </>
        ))
      }
    </nav>
  </div>
</HomeLayout>

<style>
  .home {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
  }

  /*
   * The header keeps its 3840 x 1320 coordinate system and spans the full
   * viewport width, so the wordmark stays at 2390/3840 (62.2%) of that width.
   * On ultrawide or short screens the height cap shrinks it instead.
   */
  .home__header {
    width: min(100%, calc((100dvh - 280px) * 3840 / 1320));
    margin-inline: auto;
  }

  .home__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4.5vw, 3.25rem);
    /*
     * The 1320-unit header crop carries empty space below the wordmark.
     * Pull the rows into that transparent lower band so the formula-sized
     * composition and the rows still fit a 720px or 1080px viewport.
     */
    margin-top: -2.5rem;
    list-style: none;
  }

  .home__social li {
    display: flex;
  }

  .home__nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: center;
    gap: clamp(0.5rem, 1.6vw, 1.1rem);
    margin-top: clamp(0.9rem, 3.6vh, 2rem);
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.66rem + 0.25vw, 0.875rem);
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home__nav-sep {
    color: var(--ink-60);
    font-weight: 400;
    transform: translateY(-0.05em);
  }

  @media (max-width: 640px) {
    .home__social {
      margin-top: 0.75rem;
    }

    .home__nav {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      margin-top: clamp(1.1rem, 4vh, 1.9rem);
      font-size: 0.8125rem;
      white-space: normal;
    }

    .home__nav-sep {
      display: none;
    }
  }
</style>
