---
import PageLayout from '../layouts/PageLayout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
---

<PageLayout
  title="Projects — DROOCKED.ORIGINS"
  description="Projects from DROOCKED.ORIGINS — documented builds and experiments around 3D printing, published as each one is completed."
>
  <SubpageHeader title="PROJECTS" />

  <section class="page-section reading-column" aria-labelledby="projects-empty">
    <div class="blueprint-box">
      <h2 class="blueprint-box__label" id="projects-empty">NO ENTRIES YET</h2>
      <p class="blueprint-box__text">
        THIS SECTION WILL LIST PROJECTS AS THEY ARE PUBLISHED.
      </p>
    </div>
  </section>
</PageLayout>
