---
import PageLayout from '../layouts/PageLayout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
---

<PageLayout
  title="Projects"
  description="Projects from droocked.origins — documented builds and experiments, published as they are completed."
>
  <SubpageHeader title="PROJECTS" />

  <section class="page-section" aria-labelledby="projects-empty">
    <div class="blueprint-box">
      <h2 class="blueprint-box__label" id="projects-empty">NO ENTRIES YET</h2>
      <p class="blueprint-box__text">
        THIS SECTION WILL LIST PROJECTS AS THEY ARE PUBLISHED.
      </p>
    </div>
  </section>
</PageLayout>
