---
import PageLayout from '../layouts/PageLayout.astro';
import SubpageHeader from '../components/SubpageHeader.astro';
import CmykLink from '../components/CmykLink.astro';
---

<PageLayout
  title="Sheet not found — DROOCKED.ORIGINS"
  description="The requested sheet is not part of the DROOCKED.ORIGINS drawing set."
  robots="noindex, nofollow"
>
  <SubpageHeader title="SHEET NOT FOUND" />

  <section class="page-section reading-column">
    <div class="blueprint-box not-found">
      <h2 class="blueprint-box__label">SHEET NOT FOUND / 404</h2>
      <p class="not-found__code" aria-hidden="true">404</p>
      <p class="not-found__text">
        THIS SHEET IS NOT PART OF THE DRAWING SET. IT MAY HAVE BEEN MOVED,
        RENAMED, OR NEVER ISSUED.
      </p>
      <p class="not-found__link">
        <CmykLink href="/" text="return to home" />
      </p>
    </div>
  </section>
</PageLayout>
