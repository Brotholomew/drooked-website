---
import PageLayout from '../../layouts/PageLayout.astro';
import SubpageHeader from '../../components/SubpageHeader.astro';
import { loadProducts, productRoute } from '../../lib/products';

const { products } = loadProducts();
---

<PageLayout
  title="Products — DROOCKED.ORIGINS"
  description="Products used and documented by DROOCKED.ORIGINS — 3D printers, enclosures and smart-home hardware, with producer and storefront details."
>
  <SubpageHeader title="PRODUCTS" />

  <section class="page-section products-browser reading-column" aria-labelledby="products-heading">
    <h2 class="visually-hidden" id="products-heading">Product catalogue</h2>

    <div class="products-search" role="search">
      <div class="products-search__meta">
        <label class="products-search__label" for="product-search">SEARCH</label>
        <p class="products-search__status" data-product-count aria-live="polite">
          {products.length} products
        </p>
      </div>
      <input
        class="products-search__input"
        id="product-search"
        type="search"
        placeholder="Name, type or producer"
        autocomplete="off"
        data-product-search
        aria-controls="product-list"
      />
    </div>

    <ul class="product-grid" id="product-list" role="list">
      {
        products.map((product, index) => (
          <li
            class="product-grid__item"
            data-product-card
            data-search={`${product.name} ${product.subtitle} ${product.description} ${product.producer.name}`.toLowerCase()}
          >
            <a
              class="product-card"
              href={productRoute(product)}
              data-product-id={product.id}
            >
              <span class="product-card__ticks" aria-hidden="true">
                <span class="product-card__tick product-card__tick--tl" />
                <span class="product-card__tick product-card__tick--tr" />
                <span class="product-card__tick product-card__tick--bl" />
                <span class="product-card__tick product-card__tick--br" />
              </span>

              <div class="product-card__top">
                <span
                  class="product-card__icon"
                  style={`--icon-url: url("${product.icon}")`}
                  aria-hidden="true"
                />
                <span class="product-card__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <div class="product-card__body">
                <p class="product-card__subtitle">{product.subtitle}</p>
                <h2 class="product-card__name" data-text={product.name}>
                  {product.name}
                </h2>
                <p class="product-card__description">
                  {product.description}
                </p>
              </div>

              <div class="product-card__footer">
                <span class="product-card__producer">
                  {product.producer.name}
                </span>
                <span class="product-card__cta" aria-hidden="true">
                  OPEN PRODUCT
                  <span class="product-card__arrow">→</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="products-empty" data-product-empty hidden>
      No products match that search.
    </p>
  </section>
</PageLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-product-search]');
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-product-card]'),
  );
  const count = document.querySelector<HTMLElement>('[data-product-count]');
  const empty = document.querySelector<HTMLElement>('[data-product-empty]');

  if (input && count && empty) {
    const total = cards.length;

    const update = () => {
      const terms: string[] = input.value
        .toLowerCase()
        .trim()
        .split(/\s+/)
        .filter(Boolean);
      let visible = 0;

      for (const card of cards) {
        const haystack = card.getAttribute('data-search') || '';
        const matches = terms.every((term: string) => haystack.includes(term));
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      count.textContent = `${visible} of ${total} products`;
      empty.hidden = visible !== 0;
    };

    input.addEventListener('input', update);
    update();
  }
</script>
