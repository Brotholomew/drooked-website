---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SheetEnd from '../components/SheetEnd.astro';
import type { JsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
  ogType?: 'website' | 'article' | 'product';
  jsonLd?: JsonLd | JsonLd[];
}

const { title, description, canonicalPath, robots, ogType, jsonLd } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  robots={robots}
  ogType={ogType}
  jsonLd={jsonLd}
  bodyClass="layout-page"
>
  <div class="page-shell">
    <main id="main" class="page-shell__main">
      <slot />
    </main>
    <SheetEnd />
    <Footer />
  </div>
</BaseLayout>
