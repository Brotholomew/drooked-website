---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SheetEnd from '../components/SheetEnd.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="layout-page"
  noindex={noindex}
>
  <div class="page-shell">
    <main id="main" class="page-shell__main">
      <slot />
    </main>
    <SheetEnd />
    <Footer />
  </div>
</BaseLayout>
