---
import BaseLayout from './BaseLayout.astro';
import SheetEnd from '../components/SheetEnd.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="layout-home">
  <div class="home-shell">
    <main id="main" class="home-shell__main">
      <slot />
    </main>
    <SheetEnd />
  </div>
</BaseLayout>
